            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Error ratio",
      "id": 16,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Failed / all user requests. Failed = 5xx OR the app logged an exception while handling it (many routes catch errors and redirect, so status codes alone hide failures).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 11
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(sum(rate(zunoot_http_requests_total{job=~\"$job\", route!~\"/static/.*|/metrics|/livez|/healthz|/service-worker.js\", outcome=\"error\"}[$__rate_interval])) or vector(0)) / sum(rate(zunoot_http_requests_total{job=~\"$job\", route!~\"/static/.*|/metrics|/livez|/healthz|/service-worker.js\"}[$__rate_interval]))",
          "legendFormat": "error ratio"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
