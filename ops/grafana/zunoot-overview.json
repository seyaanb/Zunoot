          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "type": "timeseries",
      "title": "Burn rate (1 = spending budget exactly on schedule)",
      "id": 13,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Page thresholds: 14.4 (1h window) and 6 (6h window). Ticket: 1 (3d window).",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "zunoot:slo_availability_errors:ratio_rate1h / 0.005",
          "legendFormat": "availability 1h"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "zunoot:slo_availability_errors:ratio_rate6h / 0.005",
          "legendFormat": "availability 6h"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "zunoot:slo_latency_slow:ratio_rate1h / 0.05",
          "legendFormat": "latency 1h"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "zunoot:slo_latency_slow:ratio_rate6h / 0.05",
          "legendFormat": "latency 6h"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
