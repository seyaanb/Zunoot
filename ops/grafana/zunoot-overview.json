          },
          "expr": "sum by (status) (rate(zunoot_http_requests_total{job=~\"$job\", route!~\"/static/.*|/metrics|/livez|/healthz|/service-worker.js\"}[$__rate_interval]))",
          "legendFormat": "{{status}}"
